import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int original = n;
        int temp = n;
        int digits = 0;

        // Count digits
        while (temp > 0) {
            digits++;
            temp = temp / 10;
        }

        int sum = 0;
        temp = n;

        // Start position from the left
        int position = digits;

        while (temp > 0) {

            int digit = temp % 10;
            int power = 1;

            for (int i = 1; i <= position; i++) {
                power = power * digit;
            }

            sum = sum + power;

            temp = temp / 10;
            position--;
        }

        if (sum == original) {
            System.out.println("Disarium Number");
        }
        else {
            System.out.println("Not Disarium Number");
        }
    }
}
