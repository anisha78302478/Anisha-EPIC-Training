import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int rev = 0;

        while (n > 0) {
            int rem = n % 2;
            rev = rev * 10 + rem;
            n = n / 2;
        }

        int binary = 0;

        while (rev > 0) {
            int digit = rev % 10;
            binary = binary * 10 + digit;
            rev = rev / 10;
        }

        System.out.println(binary);
    }
}
