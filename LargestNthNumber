import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int k = sc.nextInt();

        // Descending order
        for (int i = 0; i < n - 1; i++) {
            for (int j = i + 1; j < n; j++) {

                if (arr[i] < arr[j]) {
                    int temp = arr[i];
                    arr[i] = arr[j];
                    arr[j] = temp;
                }
            }
        }

        int count = 0;

        for (int i = 0; i < n; i++) {

            if (i == 0 || arr[i] != arr[i - 1]) {
                count++;
            }

            if (count == k) {
                System.out.println(arr[i]);
                return;
            }
        }

        System.out.println("No such largest element");
    }
}
