import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        long n = sc.nextLong();

        long first = n / 10000000;
        long second = (n / 10000) % 1000;
        long third = n % 10000;

        System.out.println(first + "-" + second + "-" + third);
    }
}
