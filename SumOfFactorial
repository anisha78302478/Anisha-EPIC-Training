import java.util.Scanner;

public class Main
{
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int sum = 0;

        for (int i = 0; i < n; i++) {

            int num = sc.nextInt();
            int factorial = 1;

            for (int j = 1; j <= num; j++) {
                factorial = factorial * j;
            }

            sum = sum + factorial;
        }

        System.out.println("Sum of factorials: " + sum);
    }
}
